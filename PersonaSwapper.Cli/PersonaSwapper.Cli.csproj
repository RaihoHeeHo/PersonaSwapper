<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer/test harness for PersonaSwapper.Core: dumps and round-trip checks against real game files. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>pswap</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PersonaSwapper.Core/PersonaSwapper.Core.csproj" />
  </ItemGroup>

</Project>
