<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test harness: runs the app window headlessly (Skia) against real game data and saves screenshots. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.2.3" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="7.3.0.3" />
    <ProjectReference Include="../PersonaSwapper.App/PersonaSwapper.App.csproj" />
  </ItemGroup>

</Project>
